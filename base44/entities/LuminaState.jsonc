{
  "name": "LuminaState",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "description": "Current internal version identifier"
    },
    "last_refactor": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of last refactor"
    },
    "active_goals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Internal active goals"
    },
    "technical_debt": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Logged self-corrections and known issues"
    }
  },
  "required": [],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}