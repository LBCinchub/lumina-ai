{
  "name": "AutopilotRun",
  "type": "object",
  "properties": {
    "owner_user_id": {
      "type": "string",
      "description": "Server-derived owner id from the authenticated session. Never client-set."
    },
    "kind": {
      "type": "string",
      "enum": [
        "task",
        "social_post",
        "marketplace_listing",
        "email"
      ],
      "default": "task"
    },
    "agent_id": {
      "type": "string",
      "description": "Optional owned UserAgent whose persona styles the output"
    },
    "goal": {
      "type": "string",
      "description": "The plain-language task"
    },
    "document_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Owner-verified Document ids used as untrusted input"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "awaiting_input",
        "awaiting_approval",
        "blocked",
        "paused",
        "completed",
        "failed",
        "cancelled"
      ],
      "default": "queued"
    },
    "plan_summary": {
      "type": "string"
    },
    "clarifying_question": {
      "type": "string"
    },
    "blocked_reason": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "capability_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "input": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "completed",
              "failed",
              "skipped"
            ]
          },
          "output": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              }
            }
          },
          "artifact_document_id": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "attempts": {
            "type": "number"
          },
          "started_at": {
            "type": "string"
          },
          "finished_at": {
            "type": "string"
          }
        }
      }
    },
    "action_draft": {
      "type": "object",
      "description": "Exact external-action content previewed to the owner",
      "properties": {
        "kind": {
          "type": "string"
        },
        "destination_id": {
          "type": "string"
        },
        "destination_label": {
          "type": "string"
        },
        "fields": {
          "type": "object"
        },
        "copy": {
          "type": "string"
        },
        "attachments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "description": "Hash-bound, expiring, single-use approval of the exact draft",
      "properties": {
        "content_hash": {
          "type": "string"
        },
        "expires_at": {
          "type": "string"
        },
        "used_at": {
          "type": "string"
        },
        "claim": {
          "type": "string"
        }
      }
    },
    "receipt": {
      "type": "object",
      "description": "Adapter receipt; mock=true means test evidence only",
      "properties": {
        "provider": {
          "type": "string"
        },
        "external_id": {
          "type": "string"
        },
        "thread_id": {
          "type": "string",
          "description": "Gmail thread id when the action was threaded"
        },
        "url": {
          "type": "string"
        },
        "mock": {
          "type": "boolean"
        },
        "verified": {
          "type": "boolean"
        },
        "at": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "final_summary": {
      "type": "string"
    },
    "lease_until": {
      "type": "string",
      "format": "date-time",
      "description": "Execution lease expiry preventing concurrent double-runs"
    },
    "lease_token": {
      "type": "string",
      "description": "Fencing token for the current lease holder. Every lease claim and completion is a server-side compare-and-swap on this token, so a stale worker can never complete another worker's step."
    },
    "audit": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string"
          },
          "event": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "description": "Redacted state-change history"
    }
  },
  "required": [
    "owner_user_id",
    "goal",
    "status"
  ],
  "rls": {
    "read": {
      "data.owner_user_id": "{{user.id}}"
    },
    "create": {
      "user_condition": {
        "role": "__server_only__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__server_only__"
      }
    },
    "delete": {
      "data.owner_user_id": "{{user.id}}"
    }
  }
}