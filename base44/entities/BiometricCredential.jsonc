{
  "name": "BiometricCredential",
  "type": "object",
  "properties": {
    "credential_id": {
      "type": "string",
      "description": "WebAuthn credential ID (base64url) generated by the device's platform authenticator"
    },
    "public_key": {
      "type": "string",
      "description": "Base64url-encoded COSE public key generated by the device. Only the public key is ever stored \u2014 no biometric data, face data, or images is collected or persisted"
    },
    "sign_count": {
      "type": "number",
      "default": 0,
      "description": "Latest assertion signature counter reported by the device"
    },
    "label": {
      "type": "string",
      "description": "Display label of the enrolled device, e.g. iPhone"
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "Revoked"
      ],
      "default": "Active",
      "description": "Whether this credential may verify"
    },
    "last_used": {
      "type": "string",
      "format": "date",
      "description": "Date the credential last verified successfully"
    }
  },
  "required": [
    "credential_id",
    "public_key",
    "status"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}