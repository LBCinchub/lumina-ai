{
  "name": "UserAgentConnection",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string",
      "description": "ID of the parent UserAgent"
    },
    "superagent_agent_id": {
      "type": "string",
      "description": "Agent ID of the user's own Base44 Superagent, copied from its API URL"
    },
    "api_key_encrypted": {
      "type": "string",
      "description": "AES-256-GCM ciphertext of the Superagent API key. Only backend functions hold the decryption key; the plaintext never returns to any client."
    },
    "status": {
      "type": "string",
      "enum": [
        "connected",
        "disconnected"
      ],
      "default": "connected",
      "description": "Connection status"
    },
    "connected_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the connection was established"
    },
    "last_processed_message_id": {
      "type": "string",
      "description": "ID of the newest Superagent message already processed by the bridge"
    },
    "last_processed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Processing watermark \u2014 only Superagent messages newer than this are synced"
    },
    "last_mirror_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the in-app chat was last mirrored to the Superagent (mirror cooldown)"
    },
    "reply_hour_key": {
      "type": "string",
      "description": "Current rate-limit hour bucket for bridge deliveries"
    },
    "reply_count": {
      "type": "number",
      "default": 0,
      "description": "Bridge deliveries sent in the current rate-limit hour bucket"
    },
    "owner_email": {
      "type": "string",
      "description": "Server-derived owner email from the authenticated session. The browser can never set or override this."
    },
    "ownership_state": {
      "type": "string",
      "enum": [
        "human_verified",
        "anonymous_legacy"
      ],
      "description": "Ownership classification stamped server-side on create"
    }
  },
  "required": [
    "agent_id",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    }
  }
}