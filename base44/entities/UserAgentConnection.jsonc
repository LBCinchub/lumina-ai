{
  "name": "UserAgentConnection",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string",
      "description": "ID of the parent UserAgent"
    },
    "channel": {
      "type": "string",
      "enum": [
        "telegram",
        "whatsapp",
        "imessage"
      ],
      "default": "telegram",
      "description": "Phone channel of the connection"
    },
    "bot_username": {
      "type": "string",
      "description": "Username of the official LBC AI bot, verified live at pair time"
    },
    "chat_id": {
      "type": "string",
      "description": "Telegram chat id of the owner's paired phone chat"
    },
    "pairing_code": {
      "type": "string",
      "description": "Single-use 6-digit pairing code, consumed by the webhook on successful pairing"
    },
    "pairing_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the pairing code expires \u2014 15 minutes after generation"
    },
    "paired_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the phone chat was paired"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_pairing",
        "connected",
        "disconnected"
      ],
      "default": "pending_pairing",
      "description": "Connection status"
    },
    "last_mirror_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the in-app chat was last mirrored to Telegram (mirror cooldown)"
    },
    "reply_hour_key": {
      "type": "string",
      "description": "Current rate-limit hour bucket for bridge deliveries"
    },
    "reply_count": {
      "type": "number",
      "default": 0,
      "description": "Bridge deliveries sent in the current rate-limit hour bucket"
    },
    "owner_email": {
      "type": "string",
      "description": "Server-derived owner email from the authenticated session. The browser can never set or override this."
    },
    "ownership_state": {
      "type": "string",
      "enum": [
        "human_verified",
        "anonymous_legacy"
      ],
      "description": "Ownership classification stamped server-side on create"
    }
  },
  "required": [
    "agent_id",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    }
  }
}