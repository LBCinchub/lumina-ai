{
  "name": "UserAgent",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Display name of the agent"
    },
    "persona": {
      "type": "string",
      "description": "Agent persona (e.g. Strategic Advisor, Creative Partner, Task Manager, Custom)"
    },
    "voice": {
      "type": "string",
      "enum": [
        "warm",
        "direct",
        "playful",
        "professional"
      ],
      "description": "Response voice of the agent"
    },
    "instructions": {
      "type": "string",
      "description": "The agent's system prompt, written by the user"
    },
    "expertise": {
      "type": "string",
      "description": "Short scope description of what the agent is for"
    },
    "knowledge_source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "References to the owner's Knowledge Sources used as context"
    },
    "owner_email": {
      "type": "string",
      "description": "Server-derived owner email from the authenticated session. The browser can never set or override this."
    },
    "ownership_state": {
      "type": "string",
      "enum": [
        "human_verified",
        "anonymous_legacy"
      ],
      "description": "Ownership classification stamped server-side on create"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active",
      "description": "Lifecycle state of the agent"
    },
    "is_private": {
      "type": "boolean",
      "default": true,
      "description": "Agents are private to their owner in V1 \u2014 always true"
    }
  },
  "required": [
    "name",
    "persona",
    "voice",
    "instructions"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    }
  }
}