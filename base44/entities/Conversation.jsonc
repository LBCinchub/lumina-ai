{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Short title summarizing the conversation"
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the most recent message"
    },
    "summary": {
      "type": "string",
      "description": "A brief summary of what was discussed"
    },
    "owner_email": {
      "type": "string",
      "description": "Canonical owner email, stamped externally by owner tools for human_verified parents. Not set for anonymous_legacy."
    },
    "ownership_state": {
      "type": "string",
      "enum": [
        "human_verified",
        "anonymous_legacy"
      ],
      "description": "Externally-stamped ownership classification. human_verified requires a normalized non-service owner_email; anonymous_legacy has no owner_email and is quarantinable as legacy anonymous. Stamped by owner tools outside this app runtime; never guessed or auto-stamped here."
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "write": {
      "created_by": "{{user.email}}"
    }
  }
}