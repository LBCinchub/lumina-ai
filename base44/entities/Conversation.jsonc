{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Short title summarizing the conversation"
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the most recent message"
    },
    "summary": {
      "type": "string",
      "description": "A brief summary of what was discussed"
    },
    "owner_email": {
      "type": "string",
      "description": "Server-derived canonical owner email, set only from authenticated server context on create. Legacy rows derive from authoritative system ownership metadata."
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "write": {
      "created_by": "{{user.email}}"
    }
  }
}