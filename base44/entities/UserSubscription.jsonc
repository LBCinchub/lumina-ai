{
  "name": "UserSubscription",
  "type": "object",
  "properties": {
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "superagent",
        "ultra"
      ],
      "default": "free",
      "description": "LBC AI plan tier \u2014 Free, Superagent ($40/mo), or Ultra ($100/mo). Sourced from the earliest canonical record; grants are owner-set, never client-set."
    },
    "requests_used": {
      "type": "number",
      "default": 0,
      "description": "Number of requests used this cycle"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "free",
        "active",
        "inactive"
      ],
      "default": "free",
      "description": "Current subscription status"
    },
    "subscription_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When subscription expires"
    },
    "last_reset_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the 24h free request limit was last reset"
    },
    "solana_tx_hash": {
      "type": "string",
      "description": "Last verified Solana transaction hash"
    },
    "build_requests_used": {
      "type": "number",
      "default": 0,
      "description": "Number of build requests used this cycle"
    },
    "last_build_reset_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the build request limit was last reset"
    }
  },
  "rls": {
    "read": {
      "created_by": "{{user.email}}"
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "created_by": "{{user.email}}"
    }
  },
  "required": []
}