{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "lbc_ai_telegram_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_telegram": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "telegramBridgeSync",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Sync Telegram Bridge",
            "description": "Process new Telegram messages"
          }
        }
      }
    ]
  },
  "name": "LBC AI Telegram Sync",
  "description": "Syncs new Telegram messages from users' connected bots to their LBC AI agents, every 5 minutes",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}