{
  "name": "Agent Autopilot Runner",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/15 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "agent_autopilot_runner",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_due_tasks": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runUserAgentTasks",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Run Due Agent Tasks",
            "description": "Due Autopilot runs"
          }
        }
      }
    ]
  },
  "description": "Runs due Autopilot tasks for user-built agents every 15 minutes \u2014 server-side only."
}